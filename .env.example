# ─── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys (or the "Connect" button at the top).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (starts with sb_publishable_…). Safe for the browser.
# Older projects: the legacy "anon" public key works here too.
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Database ──────────────────────────────────────────────────────────────
# Dashboard → Connect → ORMs (or "Connection string"). Replace [YOUR-PASSWORD].
# App runtime: Transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations (drizzle-kit) and seed: Session pooler, port 5432.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── App ───────────────────────────────────────────────────────────────────
# Public URL of the app (used in invite links and email redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Emails promoted to Global House SUPER_ADMIN on sign-in (comma-separated).
SUPER_ADMIN_EMAILS=you@example.com

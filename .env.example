# ─── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys (or the "Connect" button at the top).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (starts with sb_publishable_…). Safe for the browser.
# Older projects: the legacy "anon" public key works here too.
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Database ──────────────────────────────────────────────────────────────
# Dashboard → Connect → ORMs (or "Connection string"). Replace [YOUR-PASSWORD].
# App runtime: Transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations (drizzle-kit) and seed: Session pooler, port 5432.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── App ───────────────────────────────────────────────────────────────────
# Public URL of the app (used in invite links and email redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Emails promoted to Global House SUPER_ADMIN on sign-in (comma-separated).
SUPER_ADMIN_EMAILS=you@example.com

# Set to true once GitHub is enabled in Supabase (Authentication → Providers → GitHub)
# to show "Continue with GitHub" on the sign-in page. Email codes always work.
AUTH_GITHUB_ENABLED=false

# Optional, server-only (never NEXT_PUBLIC_). Google Cloud → YouTube Data API v3 key.
# When set, lesson lengths come from YouTube instead of the curator's number.
YOUTUBE_API_KEY=


# ─── Email (ZeptoMail) ─────────────────────────────────────────────────────
# Server-only. With both set, Lenigo sends its own branded emails (invites, React Email templates
# in src/emails). Without them, invites fall back to Supabase's sign-in code email.
# ZEPTOMAIL_PASSWORD is the Send Mail token (the SMTP password); ZEPTOMAIL_USERNAME is "emailapikey"
# and is only needed if you also point Supabase's custom SMTP at ZeptoMail.
ZEPTOMAIL_PASSWORD=
ZEPTOMAIL_USERNAME=emailapikey
# Sender; its domain must be verified in ZeptoMail.
EMAIL_FROM="Lenigo <noreply@your-domain.com>"
# Optional. ZeptoMail API endpoint for your account's region.
# ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email

# Optional, server-only (never NEXT_PUBLIC_). Supabase → Project Settings → API Keys → Secret key.
# Lets the invite email's button sign the invitee in and accept in one press.
SUPABASE_SECRET_KEY=

# Optional, server-only. Turns on /cron/workshop-reminders (session reminders by email).
# At least 24 characters, e.g. `openssl rand -base64 32`. Your scheduler sends `Authorization: Bearer <this>`.
CRON_SECRET=
